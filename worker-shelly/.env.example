# Select the existing appliance slot this worker replaces.
APPLIANCE_ROLE=washer

API_SERVER_URL=http://localhost:8001
SHELLY_URL=http://192.168.1.50
SHELLY_COMPONENT=switch:0
SHELLY_USERNAME=
SHELLY_PASSWORD=

# Readings at or above the active threshold are running.
# Readings at or below the inactive threshold are finished/inactive.
POWER_ACTIVE_THRESHOLD_W=20
POWER_INACTIVE_THRESHOLD_W=5
POWER_INACTIVE_DURATION_SECONDS=300
SHELLY_POLL_INTERVAL_SECONDS=5
HTTP_TIMEOUT_SECONDS=10

CONFIG_PATH=/config/config.json
LISTEN_ADDR=:8005
SEND_SMS_URL=https://your_sms_webhook_url
SMS_USER=your_sms_username
SMS_PASSWORD=your_sms_password
